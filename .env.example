# Copie ce fichier en .env.local et remplis les valeurs. Ne commite jamais .env.local.
# Toutes ces variables sont lues côté serveur uniquement, sauf NEXT_PUBLIC_SITE_URL.

# --- IA (étape 4) ---------------------------------------------------------
# Clé API Anthropic. Jamais exposée au navigateur.
ANTHROPIC_API_KEY=
# Modèle vision. Haiku 5.5 par défaut ; passer à claude-sonnet-5-5 si l'éval
# montre trop d'erreurs d'extraction. Aucun changement de code nécessaire.
ANTHROPIC_MODEL=claude-haiku-5-5
# Profondeur de réflexion : low (défaut, rapide et peu coûteux), medium, high, xhigh, max.
ANTHROPIC_EFFORT=low
# Délai maximal d'un appel (ms, entre 3000 et 60000) et taille maximale de la réponse (jetons).
# La transcription exhaustive des messages d'une longue conversation demande de la place et du temps.
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_MAX_TOKENS=8000

# --- Comparaison de prix (recherche web) ----------------------------------
# Bouton « Comparer le prix » : un appel Claude avec l'outil web_search (0,01 $ la recherche, plus
# les jetons ; compté dans DAILY_SPEND_CAP_USD). Utilise la même clé API. Tout est facultatif.
# Modèle qui fait la recherche (défaut : ANTHROPIC_MODEL). Si Haiku 5.5 refuse web_search_20250305
# (`pnpm check:anthropic` le dira), mettre claude-sonnet-5-5.
# ANTHROPIC_PRICE_MODEL=
# ANTHROPIC_PRICE_EFFORT=medium
# Recherches web par estimation (1 à 6), jetons de réponse, durée totale (ms, 10000 à 55000).
PRICE_SEARCH_MAX_USES=3
PRICE_MAX_TOKENS=3000
PRICE_TIMEOUT_MS=50000
# Recherches (pas les résultats en cache) par IP : au-delà, réponse 429.
PRICE_RATE_LIMIT_PER_HOUR=5
PRICE_RATE_LIMIT_PER_DAY=15
# Durée de conservation d'une estimation par (marque, modèle, état), en secondes (24 h).
PRICE_CACHE_TTL_S=86400

# --- Garde-fous (étape 5) -------------------------------------------------
# Upstash Redis sert uniquement à : rate limiting (IP hashée, TTL court), plafond de
# dépense, compteur public d'annonces vérifiées, agrégats du feedback 👍👎, identifiants
# d'analyse éphémères. Aucune capture, aucun texte, aucune IP en clair.
# Sans ces variables : repli en mémoire en développement ; EN PRODUCTION (y compris les
# previews Vercel) l'IA reste coupée : le rate limiting et le plafond ne seraient pas
# partagés entre les instances. Une base Upstash distincte par environnement.
# L'intégration Vercel peut les nommer KV_REST_API_URL / KV_REST_API_TOKEN : accepté aussi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret servant à hasher les IP avant le rate limiting (chaîne aléatoire longue,
# p. ex. `openssl rand -hex 32`). Obligatoire en production.
IP_HASH_SECRET=

# Analyses par IP : au-delà, réponse 429 avec Retry-After.
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=30

# Plafond de dépense IA par jour (UTC), tous utilisateurs confondus. Au-delà, l'IA est
# coupée et l'app passe en « règles seules » (« forte affluence, analyse partielle »).
# Les captures seules, illisibles sans IA, reçoivent alors un message clair.
# 0 coupe l'IA en permanence.
DAILY_SPEND_CAP_USD=1

# Détail technique affiché à l'utilisateur quand l'IA n'a pas pu servir (variables manquantes,
# code HTTP d'Anthropic). Affiché par défaut, partout. À METTRE À false AVANT D'OUVRIR AU PUBLIC :
# il ne reste alors qu'une phrase générale qui ne révèle rien de la configuration.
# SHOW_DIAGNOSTICS=false

# Durée (secondes) pendant laquelle le compteur public n'est pas relu.
COUNTER_CACHE_SECONDS=300

# --- Site -----------------------------------------------------------------
# URL publique (carte de partage, métadonnées, manifest PWA).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fonctionnalités optionnelles ----------------------------------------
# Récupération best-effort des liens d'annonce Vinted / Leboncoin (étape 10).
FEATURE_LISTING_FETCH=false
